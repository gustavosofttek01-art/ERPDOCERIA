# =========================================================
# DoceControl ERP - Variáveis de Ambiente
# =========================================================

# Ambiente de execução: development | production | test
NODE_ENV=development
APP_URL=http://localhost:3000

# Banco de Dados Supabase (PostgreSQL)
# Em produção, aponte para sua instância Supabase:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
DATABASE_URL=postgresql://postgres.your-project-id:password@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Modo Local / Standalone:
# Se NEXT_PUBLIC_SUPABASE_URL não for informada, o sistema inicializa
# automaticamente o motor PostgreSQL embedded (PGlite) com persistência local em ./data/pgdata
PG_DATA_DIR=./data/pgdata

# WhatsApp Business Cloud API Oficial (Meta Graph API)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=docecontrol_secure_verify_token_2026
WHATSAPP_BUSINESS_ACCOUNT_ID=

# WhatsApp Adaptador Evolution API (Opcional / Autohospedado)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=docecontrol-main

# Integração iFood Merchant API (Homologação / Produção)
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
IFOOD_MERCHANT_ID=
IFOOD_ENVIRONMENT=sandbox # sandbox | production

# Integração 99Food Partner API
NNFOOD_APP_KEY=
NNFOOD_APP_SECRET=
NNFOOD_SHOP_ID=

# Segurança & Criptografia
JWT_SECRET=docecontrol-super-secret-key-change-in-production-min-32-chars
INTERNAL_CRON_KEY=cron-security-token-docecontrol-2026
